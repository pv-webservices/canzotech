{
  "name": "canzotech-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "test:e2e": "playwright test",
    "audit:seo": "node scripts/audit-seo.mjs",
    "images": "node scripts/optimize-images.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run audit:seo && npm run test:e2e"
  },
  "dependencies": {
    "next": "^15.5.27",
    "nodemailer": "^10.0.14",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "node-html-parser": "^9.0.4",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "sharp": "^0.35.5"
  }
}
