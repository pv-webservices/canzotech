# Copy to .env.local for local testing. In production these are set in Hostinger hPanel
# (Websites > canzotech.com > Node.js app settings > Environment variables), never committed.

# Zoho Mail (India data centre) SMTP — the client's own mailbox sends every enquiry.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=info@canzotech.com
# Zoho app-specific password (Zoho Mail > Settings > Security > App Passwords). Secret — never commit.
SMTP_PASS=

# Who receives enquiries (comma-separated) and the sending address (must be SMTP_USER or a Zoho alias of it).
MAIL_TO=info@canzotech.com,vishwajit@canzotech.com,sunita.ku@canzotech.com
MAIL_FROM=info@canzotech.com

# Optional: extra origins allowed to post the form, comma-separated (e.g. a staging domain).
ALLOWED_ORIGINS=
